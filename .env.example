# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated. Add your deployed frontend origin before going live.
CORS_ORIGINS=http://localhost:3000
# Matches Vercel preview deployments. Set to an empty value to disable.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ── Upstream identity (required by Nominatim's usage policy) ─────────────────
# Use a real address you monitor. Nominatim answers any request whose User-Agent carries a
# placeholder address (anything @example.com and friends) with HTTP 403 — so those are stripped
# out rather than sent. Leaving this blank works, identifying the deployment by APP_URL alone.
CONTACT_EMAIL=
APP_URL=https://github.com/mahmudrafi24/cafe_scraping

# ── Upstream endpoints ───────────────────────────────────────────────────────
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# Photon powers city autocomplete; Nominatim matches whole names only and cannot do prefixes.
# Blank this to disable suggestions and fall back to Nominatim. Self-host for heavy traffic.
PHOTON_BASE_URL=https://photon.komoot.io
# Language for place labels, sent to both geocoders.
PREFERRED_LANGUAGE=en

# ── Timeouts and retries ─────────────────────────────────────────────────────
# The total request budget includes retries and fallback mirrors (Vercel limit: 60s).
REQUEST_TIMEOUT_SECONDS=55
UPSTREAM_TIMEOUT_SECONDS=16
OVERPASS_QUERY_TIMEOUT_SECONDS=12
# Each mirror has its own budget, even when legacy upstream/retry overrides are present.
OVERPASS_ATTEMPT_TIMEOUT_SECONDS=16
MAX_RETRIES=0
MAX_CONCURRENT_REQUESTS=4
REQUESTS_PER_MINUTE=30
RETRY_BACKOFF_SECONDS=1.5

# ── Search defaults ──────────────────────────────────────────────────────────
DEFAULT_RADIUS_KM=10
CITY_SUGGESTION_LIMIT=8

# ── Geocoding cache ──────────────────────────────────────────────────────────
CITY_CACHE_TTL_SECONDS=86400
CITY_CACHE_MAX_ENTRIES=512

# Complete place results shared across users in this process. 0 TTL disables caching.
# Defaults retain at most 8 x 2 MB of serialized results, plus temporary request objects.
PLACE_CACHE_TTL_SECONDS=600
PLACE_CACHE_MAX_ENTRIES=8
PLACE_CACHE_MAX_ENTRY_BYTES=2000000
